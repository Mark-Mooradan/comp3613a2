                  "pm.test('successful redemption changes balance and inventory', function () {\n    pm.response.to.have.status(200);\n    const html = pm.response.text();\n    const balanceMatch = html.match(/Your Balance:\\s*([\\d.]+)\\s*Hours/);\n    pm.expect(balanceMatch, 'updated balance shown in hours').not.to.be.null;\n    if (balanceMatch) {\n        const expectedBalance = Number(pm.collectionVariables.get('startingBalance')) + 16.5;\n        pm.expect(Number(balanceMatch[1])).to.be.closeTo(expectedBalance, 0.01);\n    }\n    const prizeIndex = html.indexOf(pm.collectionVariables.get('prizeName'));\n    const rowEnd = html.indexOf('</tr>', prizeIndex);\n    const row = prizeIndex >= 0 ? html.slice(prizeIndex, rowEnd) : '';\n    pm.expect(row).to.include('<td>1</td>');\n});"
