              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin login redirects successfully', function () {\n    pm.response.to.have.status(303);\n});\nconst setCookie = pm.response.headers.get('Set-Cookie') || '';\nconst cookieMatch = setCookie.match(/(?:^|,\\s*)(access_token=[^;,\\s]+)/);\npm.test('admin session cookie is captured', function () {\n    pm.expect(cookieMatch, 'access_token cookie').not.to.be.null;\n});\nif (cookieMatch) { pm.collectionVariables.set('sessionCookie', cookieMatch[1]); }"
                ]
