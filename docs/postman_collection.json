          "name": "Find created prize ID and check balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('student sees the approved-hours balance and prize', function () {\n    pm.response.to.have.status(200);\n});\nconst html = pm.response.text();\nconst balanceMatch = html.match(/Your Balance:\\s*([\\d.]+)\\s*Hours/);\npm.test('approved volunteer hours are reflected in balance', function () {\n    pm.expect(balanceMatch, 'balance shown in hours').not.to.be.null;\n    if (balanceMatch) {\n        const expectedBalance = Number(pm.collectionVariables.get('startingBalance')) + 20;\n        pm.expect(Number(balanceMatch[1])).to.be.closeTo(expectedBalance, 0.01);\n    }\n});\nconst prizeName = pm.collectionVariables.get('prizeName');\nconst prizeIndex = html.indexOf(prizeName);\nconst rowStart = html.lastIndexOf('<tr', prizeIndex);\nconst rowEnd = html.indexOf('</tr>', prizeIndex);\nconst row = prizeIndex >= 0 ? html.slice(rowStart, rowEnd) : '';\nconst prizeMatch = row.match(/\\/rewards\\/(\\d+)\\/redeem/);\npm.test('created prize ID is extracted from its redeem link', function () {\n    pm.expect(prizeIndex, 'created prize listed').to.be.above(-1);\n    pm.expect(prizeMatch, 'prize redeem route').not.to.be.null;\n});\nif (prizeMatch) { pm.collectionVariables.set('prizeId', prizeMatch[1]); }"
