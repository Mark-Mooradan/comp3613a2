        {
          "name": "Find submitted entry ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin sees the submitted pending entry', function () {\n    pm.response.to.have.status(200);\n});\nconst html = pm.response.text();\nconst activity = pm.collectionVariables.get('activityName');\nconst activityIndex = html.indexOf(activity);\nconst rowStart = html.lastIndexOf('<tr', activityIndex);\nconst rowEnd = html.indexOf('</tr>', activityIndex);\nconst row = activityIndex >= 0 ? html.slice(rowStart, rowEnd) : '';\nconst entryMatch = row.match(/\\/admin\\/volunteer-hours\\/(\\d+)\\/review/);\npm.test('submitted entry ID is extracted from the review link', function () {\n    pm.expect(html).to.include(activity);\n    pm.expect(entryMatch, 'entry review route').not.to.be.null;\n});\nif (entryMatch) { pm.collectionVariables.set('entryId', entryMatch[1]); }"
                ]
              }
            }
